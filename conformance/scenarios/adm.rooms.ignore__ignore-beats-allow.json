{
  "id": "adm.rooms.ignore/ignore-beats-allow",
  "rule": "adm.rooms.ignore",
  "policy": "policy-team.json",
  "patch": {
    "surfaces.fake.rooms": [
      {
        "match": {
          "room": "r-general"
        },
        "mode": "mention"
      },
      {
        "match": {
          "room": "r-general"
        },
        "mode": "ignore"
      }
    ]
  },
  "steps": [
    {
      "say": {
        "text": "hi {{canary}}",
        "room": "r-general",
        "sender": "u-alice",
        "mention": true
      }
    }
  ],
  "expect": {
    "heard": false,
    "answered": false,
    "receipt": {
      "verdict": "drop",
      "rule": "adm.rooms.ignore"
    }
  },
  "twin": {
    "patch": {
      "surfaces.fake.rooms": [
        {
          "match": {
            "room": "r-general"
          },
          "mode": "mention"
        }
      ]
    },
    "expect": {
      "heard": true,
      "answered": true,
      "receipt": {
        "verdict": "deliver",
        "rule": "addr.mention"
      }
    }
  }
}
