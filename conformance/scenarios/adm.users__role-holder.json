      "surfaces.fake.users": [
        {
          "kind": "user",
          "id": "u-alice"
        }
      ]
    },
    "expect": {
      "heard": false,
      "answered": false,
      "receipt": {
        "verdict": "drop",
        "rule": "adm.users"
      }
    }
  }
