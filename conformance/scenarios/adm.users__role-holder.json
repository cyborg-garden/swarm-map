{
  "id": "adm.users/role-holder",
  "rule": "adm.users",
  "policy": "policy-team.json",
  "steps": [
    {
      "say": {
        "text": "hi {{canary}}",
        "room": "r-general",
        "sender": {
          "id": "u-bob",
          "roles": [
            "role-staff"
          ]
        },
        "mention": true
      }
