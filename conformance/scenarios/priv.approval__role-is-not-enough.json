{
  "id": "priv.approval/role-is-not-enough",
  "rule": "priv.approval",
  "policy": "policy-team.json",
  "patch": {
    "surfaces.fake.admins": [
      {
        "kind": "role",
        "id": "role-staff"
      }
    ]
  },
  "steps": [
    {
      "approval": {
        "room": "r-general",
        "approver": {
          "id": "u-bob",
          "roles": [
            "role-staff"
          ]
        }
      }
    }
  ],
  "expect": {
    "receipt": {
      "verdict": "deny",
      "rule": "priv.approval"
    },
    "privilege": "guest"
  },
  "twin": {
    "patch": {
      "surfaces.fake.admins": [
        {
          "kind": "user",
          "id": "u-bob"
        }
      ]
    },
    "expect": {
      "receipt": {
        "verdict": "allow",
        "rule": "priv.approval"
      },
      "privilege": "admin"
    }
  }
}
