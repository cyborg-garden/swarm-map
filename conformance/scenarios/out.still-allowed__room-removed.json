{
  "id": "out.still-allowed/room-removed",
  "rule": "out.still-allowed",
  "policy": "policy-team.json",
  "patch": {
    "surfaces.fake.rooms": [
      {
        "match": {
          "room": "r-lounge"
        },
        "mode": "free"
      }
    ]
  },
  "steps": [
    {
      "outbound": {
        "room": "r-general",
        "text": "reply {{canary}}"
      }
    }
  ],
  "expect": {
