ata-active:border-input dark:data-active:bg-input/30 dark:data-active:text-foreground after:absolute after:bg-foreground after:opacity-0 after:transition-opacity group-data-horizontal/tabs:after:inset-x-0 group-data-horizontal/tabs:after:bottom-[-5px] group-data-horizontal/tabs:after:h-0.5 group-data-vertical/tabs:after:inset-y-0 group-data-vertical/tabs:after:-right-1 group-data-vertical/tabs:after:w-0.5 group-data-[variant=line]/tabs-list:data-active:after:opacity-100">Settings</button></div><div data-orientation="horizontal" data-activation-direction="none" id="base-ui-_r_j_" role="tabpanel" tabindex="0" data-index="0" data-slot="tabs-content" class="flex-1 text-sm outline-none mt-4" aria-labelledby="base-ui-_r_a_"><div class="grid grid-cols-2 gap-4"><div class="rounded-xl border border-[var(--border)] bg-[var(--surface)] p-4 space-y-3"><h3 class="font-medium text-sm">Runtime</h3><div class="flex justify-between text-sm"><span class="text-muted-foreground">Runtime</span><span class="">hermes</span></div><div class="flex justify-between text-sm"><span class="text-muted-foreground">Platform</span><span class="">discord / general</span></div><div class="flex justify-between text-sm"><span class="text-muted-foreground">Status</span><span class="">running</span></div><div class="flex justify-between text-sm"><span class="text-muted-foreground">Models</span><span class="">provider/model-a</span></div></div><div class="rounded-xl border border-[var(--border)] bg-[var(--surface)] p-4 space-y-3"><h3 class="font-medium text-sm">Usage</h3><div class="flex justify-between text-sm"><span class="text-muted-foreground">Sessions today</span><span class="">—</span></div><div class="flex justify-between text-sm"><span class="text-muted-foreground">Cost today</span><span class="">$1.50</span></div><div class="flex justify-between text-sm"><span class="text-muted-foreground">Cost this week</span><span class="">—</span></div><div class="flex justify-between text-sm"><span class="text-muted-foreground">Cost this month</span><span class="">—</span></div><div class="flex justify-between text-sm"><span class="text-muted-foreground">CPU</span><span class="">3%</span></div><div class="flex justify-between text-sm"><span class="text-muted-foreground">Memory</span><span class="">120 MiB</span></div></div></div></div></div><div class="rounded-xl border border-[var(--border)] bg-[var(--surface)] p-4 space-y-3 mt-6"><h3 class="font-medium text-sm text-muted-foreground">Runtime Info</h3><div class="space-y-2"><p class="text-sm text-muted-foreground">No runtime info configured.</p></div></div><dialog class="backdrop:bg-black/50 rounded-xl border border-[var(--border)] bg-[var(--background)] p-6 w-full max-w-md shadow-xl"><div class="space-y-4"><div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-phone h-5 w-5 text-[var(--accent)]" aria-hidden="true"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"></path></svg><h2 class="text-lg font-semibold">Connect Signal</h2></div><div class="flex items-center justify-center py-8"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-loader-circle h-6 w-6 animate-spin text-muted-foreground" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg><span class="ml-2 text-sm text-muted-foreground">Checking Signal daemon...</span></div></div></dialog><dialog class="backdrop:bg-black/50 rounded-xl border border-[var(--border)] bg-[var(--background)] p-6 w-full max-w-md shadow-xl"><div class="space-y-4"><div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-square h-5 w-5 text-[var(--accent)]" aria-hidden="true"><path d="M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z"></path></svg><h2 class="text-lg font-semibold">Connect Telegram</h2></div><div class="space-y-4"><div class="p-3 rounded-lg bg-muted/50 text-sm space-y-2"><p class="font-medium">Setup instructions:</p><ol class="list-decimal list-inside space-y-1 text-muted-foreground"><li>Open Telegram and message <strong>@BotFather</strong></li><li>Send <code>/newbot</code> and follow the prompts</li><li>Copy the bot token (looks like <code>123456:ABC-DEF...</code>)</li></ol></div><div class="space-y-1"><label class="text-sm font-medium">Bot Token</label><input placeholder="123456789:ABCdefGHIjklMNOpqrsTUVwxyz" class="w-full px-3 py-2 rounded-md border border-[var(--border)] bg-[var(--surface)] text-base md:text-sm font-mono" type="text" value=""></div><div class="space-y-1"><label class="text-sm font-medium">Admins (optional)</label><input placeholder="123456789, @username" class="w-full px-3 py-2 rounded-md border border-[var(--border)] bg-[var(--surface)] text-sm" type="text" value=""><p class="text-xs text-muted-foreground">Who can manage this bot. One or more entries, comma-separated — numeric Telegram user IDs or @usernames; @usernames are resolved to IDs automatically.</p></div><div class="flex justify-end gap-2"><button class="px-3 py-1.5 text-sm rounded-md border border-[var(--border)] hover:bg-muted">Cancel</button><button disabled="" class="px-3 py-1.5 text-sm rounded-md bg-[var(--accent)] text-white hover:opacity-90 disabled:opacity-50">Verify</button></div></div></div></dialog><dialog class="backdrop:bg-black/50 rounded-xl border border-[var(--border)] bg-[var(--background)] p-6 w-full max-w-md shadow-xl"><div class="space-y-4"><div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-hash h-5 w-5 text-[var(--accent)]" aria-hidden="true"><line x1="4" x2="20" y1="9" y2="9"></line><line x1="4" x2="20" y1="15" y2="15"></line><line x1="10" x2="8" y1="3" y2="21"></line><line x1="16" x2="14" y1="3" y2="21"></line></svg><h2 class="text-lg font-semibold">Connect Mattermost</h2></div><div class="space-y-4"><div class="p-3 rounded-lg bg-muted/50 text-sm space-y-2"><p class="font-medium">Setup instructions:</p><ol class="list-decimal list-inside space-y-1 text-muted-foreground"><li>In Mattermost, go to <strong>Integrations → Bot Accounts</strong></li><li>Click <strong>Add Bot Account</strong> and configure it</li><li>Copy the bot token after creation</li></ol></div><div class="space-y-1"><label class="text-sm font-medium">Server URL</label><input placeholder="https://mattermost.example.com" class="w-full px-3 py-2 rounded-md border border-[var(--border)] bg-[var(--surface)] text-sm" type="url" value=""></div><div class="space-y-1"><label class="text-sm font-medium">Bot Token</label><input placeholder="xxxxxxxxxxxxxxxxxxxxxxxxxxxx" class="w-full px-3 py-2 rounded-md border border-[var(--border)] bg-[var(--surface)] text-base md:text-sm font-mono" type="password" value=""></div><div class="space-y-1"><label class="text-sm font-medium">Admin Username (optional)</label><input placeholder="Your Mattermost username" class="w-full px-3 py-2 rounded-md border border-[var(--border)] bg-[var(--surface)] text-sm" type="text" value=""><p class="text-xs text-muted-foreground">Who can manage this bot.</p></div><div class="flex justify-end gap-2"><button class="px-3 py-1.5 text-sm rounded-md border border-[var(--border)] hover:bg-muted">Cancel</button><button disabled="" class="px-3 py-1.5 text-sm rounded-md bg-[var(--accent)] text-white hover:opacity-90 disabled:opacity-50">Verify</button></div></div></div></dialog><dialog class="backdrop:bg-black/50 rounded-xl border border-[var(--border)] bg-[var(--background)] p-6 w-full max-w-md shadow-xl"><div class="space-y-4"><div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-hash h-5 w-5 text-[var(--accent)]" aria-hidden="true"><line x1="4" x2="20" y1="9" y2="9"></line><line x1="4" x2="20" y1="15" y2="15"></line><line x1="10" x2="8" y1="3" y2="21"></line><line x1="16" x2="14" y1="3" y2="21"></line></svg><h2 class="text-lg font-semibold">Connect Discord</h2></div><div class="space-y-4"><div class="p-3 rounded-lg bg-muted/50 text-sm space-y-2"><p class="font-medium">Setup instructions:</p><ol class="list-decimal list-inside space-y-1 text-muted-foreground"><li>Open the <strong>Discord Developer Portal</strong> → <strong>Applications</strong></li><li>Create an application, then add a <strong>Bot</strong></li><li>Enable the <strong>Message Content</strong> privileged intent</li><li>Copy the bot token and invite the bot to your server</li></ol></div><div class="space-y-1"><label class="text-sm font-medium">Bot Token</label><input placeholder="MTAxxxxxxxxxxxxxxxxxxxxxx.xxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxx" class="w-full px-3 py-2 rounded-md border border-[var(--border)] bg-[var(--surface)] text-base md:text-sm font-mono" type="text" value=""></div><div class="space-y-1"><label class="text-sm font-medium">Admin (optional)</label><input placeholder="Your Discord user ID" class="w-full px-3 py-2 rounded-md border border-[var(--border)] bg-[var(--surface)] text-sm" type="text" value=""><p class="text-xs text-muted-foreground">Who can manage this bot. Numeric Discord user ID.</p></div><div class="flex justify-end gap-2"><button class="px-3 py-1.5 text-sm rounded-md border border-[var(--border)] hover:bg-muted">Cancel</button><button disabled="" class="px-3 py-1.5 text-sm rounded-md bg-[var(--accent)] text-white hover:opacity-90 disabled:opacity-50">Verify</button></div></div></div></dialog><dialog class="backdrop:bg-black/50 rounded-xl border border-[var(--border)] bg-[var(--background)] p-6 w-full max-w-md shadow-xl"><div class="space-y-4"><div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-square h-5 w-5 text-[var(--accent)]" aria-hidden="true"><path d="M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z"></path></svg><h2 class="text-lg font-semibold">Connect Slack</h2></div><div class="space-y-4"><div class="p-3 rounded-lg bg-muted/50 text-sm space-y-2"><p class="font-medium">Setup instructions:</p><ol class="list-decimal list-inside space-y-1 text-muted-foreground"><li>Create a Slack app at <strong>api.slack.com/apps</strong></li><li>Enable <strong>Socket Mode</strong> → generate an app-level token (<code>xapp-</code>) with <code>connections:write</code></li><li>Add bot scopes (<code>app_mentions:read</code>, <code>chat:write</code>, <code>channels:history</code>, <code>im:history</code>)</li><li>Install to the workspace and copy the <strong>Bot User OAuth Token</strong> (<code>xoxb-</code>)</li></ol></div><div class="space-y-1"><label class="text-sm font-medium">Bot Token</label><input placeholder="xoxb-..." class="w-full px-3 py-2 rounded-md border border-[var(--border)] bg-[var(--surface)] text-base md:text-sm font-mono" type="text" value=""></div><div class="space-y-1"><label class="text-sm font-medium">App Token</label><input placeholder="xapp-..." class="w-full px-3 py-2 rounded-md border border-[var(--border)] bg-[var(--surface)] text-base md:text-sm font-mono" type="text" value=""></div><div class="space-y-1"><label class="text-sm font-medium">Admin (optional)</label><input placeholder="Your Slack user ID (U...)" class="w-full px-3 py-2 rounded-md border border-[var(--border)] bg-[var(--surface)] text-sm" type="text" value=""><p class="text-xs text-muted-foreground">Who can manage this bot. Slack user ID (e.g. U01234567).</p></div><div class="flex justify-end gap-2"><button class="px-3 py-1.5 text-sm rounded-md border border-[var(--border)] hover:bg-muted">Cancel</button><button disabled="" class="px-3 py-1.5 text-sm rounded-md bg-[var(--accent)] text-white hover:opacity-90 disabled:opacity-50">Verify</button></div></div></div></dialog></div>"`;

