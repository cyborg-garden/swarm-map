# Path to directory containing Hermes docker-compose files
HERMES_DIR=~/hermes-agent

# Data directory for Swarm Map config, keys, audit log
DATA_DIR=~/.hermes-swarm-map

# Port for the Swarm Map UI
# Production convention: 3002 (pinned, no auto-increment)
# Dev mode: defaults to 3000, auto-increments if occupied
PORT=3002

# Comma-separated list of allowed dev origins (for remote dev access)
# Example: ALLOWED_DEV_ORIGINS=my-server.local,192.168.1.100
ALLOWED_DEV_ORIGINS=

# Operator token for the auth gate. SERVER-ONLY secret — never expose to agents
# or the client (no NEXT_PUBLIC_).
# FAIL-CLOSED: if unset/empty, gated requests are REFUSED with 503 rather than
# served open. On first run Swarm Map generates one and writes it to .env.local
# (gitignored, 0600); read it there to sign in at /login. To set your own:
#   openssl rand -hex 32
# Unset it only if you understand that the gate then cannot admit anyone.
HSM_OPERATOR_TOKEN=
