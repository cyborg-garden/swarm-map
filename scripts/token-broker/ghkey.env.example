# Copy to ~/.config/token-broker/ghkey.env on the machine you run ghkey from.
# Environment variables of the same name take precedence over this file.

# ssh host (an alias from ~/.ssh/config works) of the machine running the broker.
GHKEY_SSH_HOST=agent-host
# GitHub organization that owns the App.
GHKEY_GITHUB_ORG=your-org
# The App's slug: the last part of its settings URL, and the prefix of the
# private-key file GitHub downloads (<slug>.<date>.private-key.pem).
GHKEY_APP_SLUG=your-github-app
